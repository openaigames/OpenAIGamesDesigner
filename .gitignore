.DS_Store
Thumbs.db
__pycache__/
*.pyc
.godot/
dist/
/tests/dashboard-test-*/


# Local visual drafts stay out of the distributed toolkit.
/README.preview.md
/.github/assets/*-preview.svg

# Local prototypes and trial assets are kept outside release sources.
/prototypes/

# Maintainer release notes and review receipts stay local.
/VERSION
/RELEASE*.md
/CHANGELOG*.md
/.local-review/
/tests/validation-v*.md
/tests/evidence/
/tests/reports/
/.coverage
/htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Machine-local credentials and runtime state (never release material).
.env
.env.*
!.env.example
!.env.template
credentials/
secrets/
credentials*.json
secrets*.json
*.pem
*.key
*.p12
*.pfx
*.log
*.pid
*.ready.json
ready.json
.openaigame/
.asset-browser/
.venv/
node_modules/
/work/
/outputs/
/action-test-output/
/tools/workbench/web/demo/

# Local development records are not public project documentation.
/docs/CURRENT.md
/docs/project/*
!/docs/project/README.md
!/docs/project/README.zh-CN.md

# Machine-specific trial and installation scripts remain local.
/tests/scenarios/motion_cases/*
!/tests/scenarios/motion_cases/README.md
!/tests/scenarios/motion_cases/README.zh-CN.md
/tests/scenarios/runtime_cases/*
!/tests/scenarios/runtime_cases/README.md
!/tests/scenarios/runtime_cases/README.zh-CN.md
/tests/scenarios/motion_playback/
