{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "engine-session",
  "type": "object",
  "required": ["schema_version", "project", "engine", "status"],
  "properties": {
    "schema_version": {"const": 1},
    "project": {"type": "string", "minLength": 1},
    "engine": {"enum": ["unity", "unreal"]},
    "status": {"enum": ["creating", "checkpointing", "running", "completed", "needs_review", "failed", "interrupted", "restoring", "restored"]},
    "operation": {"enum": ["create", "execute"]},
    "verification": {"type": "string", "minLength": 1},
    "owner_pid": {"type": "integer", "minimum": 1},
    "pid": {"type": "integer", "minimum": 1},
    "before": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "after": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "evidence_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "related_records": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "gameplay_validation": {"const": "not_run"},
    "visual_validation": {"const": "not_run"}
  }
}
