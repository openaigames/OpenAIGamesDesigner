{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "project",
  "type": "object",
  "required": [
    "schema_version",
    "engine",
    "engine_root"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "engine": {
      "enum": [
        "godot",
        "unity",
        "unreal",
        "threejs",
        "phaser"
      ]
    },
    "engine_root": {
      "type": "string",
      "minLength": 1
    },
    "godot_executable": {
      "type": "string"
    },
    "editor_executable": {
      "type": "string"
    },
    "node_executable": {
      "type": "string"
    },
    "package_manager_cli": {
      "type": "string"
    },
    "expected_version": {
      "type": "string"
    },
    "project_file": {
      "type": "string"
    },
    "commands": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      }
    },
    "godot": {
      "type": "object",
      "properties": {
        "export_filename": {
          "type": "string",
          "minLength": 1
        },
        "export_mode": {
          "enum": [
            "debug",
            "release"
          ]
        }
      }
    },
    "unity": {
      "type": "object",
      "properties": {
        "smoke_scene": {
          "type": "string",
          "minLength": 1
        },
        "smoke_seconds": {
          "type": "number",
          "minimum": 1
        },
        "test_platform": {
          "enum": [
            "EditMode",
            "PlayMode"
          ]
        },
        "test_filter": {
          "type": "string",
          "minLength": 1
        },
        "build_target": {
          "type": "string",
          "minLength": 1
        },
        "build_scenes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "build_name": {
          "type": "string",
          "minLength": 1
        },
        "development": {
          "type": "boolean"
        }
      }
    },
    "unreal": {
      "type": "object",
      "properties": {
        "smoke_map": {
          "type": "string",
          "minLength": 1
        },
        "smoke_seconds": {
          "type": "number",
          "minimum": 1
        },
        "test_filter": {
          "type": "string",
          "minLength": 1
        },
        "dotnet_executable": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "configuration": {
          "enum": [
            "Debug",
            "DebugGame",
            "Development",
            "Test",
            "Shipping"
          ]
        },
        "build_target": {
          "type": "string",
          "minLength": 1
        },
        "export_maps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "web": {
      "type": "object",
      "properties": {
        "smoke_root": {
          "type": "string",
          "minLength": 1
        },
        "playwright_module": {
          "type": "string",
          "minLength": 1
        },
        "browser_executable": {
          "type": "string",
          "minLength": 1
        },
        "smoke_seconds": {
          "type": "number",
          "minimum": 1
        }
      }
    }
  }
}
