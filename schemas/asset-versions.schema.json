{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Immutable asset version library",
  "type": "object",
  "required": [
    "schemaVersion",
    "revision",
    "groups"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "groups": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "id",
          "title",
          "kind",
          "selected",
          "versions",
          "decisions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^VG[0-9a-f]{16}$"
          },
          "title": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "image",
              "model",
              "animation",
              "texture",
              "audio",
              "video",
              "vfx",
              "engine",
              "code",
              "other"
            ]
          },
          "selected": {
            "type": [
              "string",
              "null"
            ]
          },
          "versions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "number",
                "createdAt",
                "parent",
                "references",
                "note",
                "files",
                "provenance",
                "fingerprint",
                "archived"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^V[0-9a-f]{16}$"
                },
                "number": {
                  "type": "integer",
                  "minimum": 1
                },
                "createdAt": {
                  "type": "string"
                },
                "parent": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "references": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "group",
                      "version",
                      "role"
                    ],
                    "properties": {
                      "group": {
                        "type": "string",
                        "pattern": "^VG[0-9a-f]{16}$"
                      },
                      "version": {
                        "type": "string",
                        "pattern": "^V[0-9a-f]{16}$"
                      },
                      "role": {
                        "type": "string"
                      }
                    }
                  }
                },
                "note": {
                  "type": "string"
                },
                "files": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "path",
                      "sourcePath",
                      "sha256",
                      "bytes",
                      "role"
                    ],
                    "properties": {
                      "path": {
                        "type": "string"
                      },
                      "sourcePath": {
                        "type": "string"
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "bytes": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "role": {
                        "type": "string"
                      }
                    }
                  }
                },
                "provenance": {
                  "type": "object"
                },
                "fingerprint": {
                  "type": "string"
                },
                "archived": {
                  "type": "boolean"
                }
              }
            }
          },
          "decisions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "at",
                "from",
                "to",
                "reason"
              ],
              "properties": {
                "at": {
                  "type": "string"
                },
                "from": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "to": {
                  "type": "string",
                  "pattern": "^V[0-9a-f]{16}$"
                },
                "reason": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
