{
 "$schema":"https://json-schema.org/draft/2020-12/schema","title":"Explicit project sources, constraints and consumers",
 "type":"object","additionalProperties":false,"required":["schema_version","objects","constraints"],
 "properties":{
  "schema_version":{"const":1},
  "objects":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","title"],"properties":{
   "id":{"type":"string","minLength":1},"title":{"type":"string","minLength":1},
   "links":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["role","source","locator","description"],"properties":{
    "role":{"enum":["rule","engine","asset","animation","vfx","audio","space","parameter","issue"]},
    "source":{"type":"string","minLength":1},"locator":{"type":"string","minLength":1},"description":{"type":"string","minLength":1}
   }}}
  }}},
  "constraints":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","domain","description","unit","source","consumers"],"properties":{
   "id":{"type":"string","minLength":1},"domain":{"enum":["scale","movement","timing","platform","other"]},
   "description":{"type":"string","minLength":1},"unit":{"type":"string","minLength":1},
   "source":{"type":"object","additionalProperties":false,"required":["kind","path","locator","provenance"],"properties":{
    "kind":{"enum":["json","native","document"]},"path":{"type":"string","minLength":1},"locator":{"type":"string","minLength":1},
    "pointer":{"type":"string","minLength":1},"evidence":{"type":"string","minLength":1},
    "provenance":{"enum":["project_authored","asset_default","author_example","runtime_readback","reference_measured","estimate"]}
   }},
   "consumers":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["object","source","locator","checks"],"properties":{
    "object":{"type":"string","minLength":1},"source":{"type":"string","minLength":1},"locator":{"type":"string","minLength":1},
    "checks":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}
   }}}
  }}}
 }
}
