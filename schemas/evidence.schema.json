{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence: actual source, observation and dependency versions",
  "type": "object",
  "required": ["schema_version", "id", "created_at", "source_type", "description", "observer", "result", "objects", "files", "dependencies", "limitations"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"},
    "created_at": {"type": "string", "minLength": 1},
    "source_type": {"enum": ["engine", "command", "host_tool", "manual"]},
    "description": {"type": "string", "minLength": 1},
    "observer": {"type": "string", "minLength": 1},
    "result": {"enum": ["observed", "passed", "failed", "partial", "not_run"]},
    "objects": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "files": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "dependencies": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "task": {"type": "string", "minLength": 1},
    "execution_ref": {"type": "string", "minLength": 1}
  }
}
